    {
      "id": "mtt-30",
      "name": "Tournament preflop",
      "description": "Opening, defending and facing 3-bets and shoves with 30bb stacks, the middle stage of most tournaments.",
      "game": "mtt",
      "stack": 30,
      "lessons": [
        {
          "id": "opens-early",
          "title": "Opening from early position",
          "body": [
            "The basics are the same as in cash games: the earlier your seat, the more players can wake up with a strong hand behind you, so the tighter you open.",
            "The table shows how each chart splits its hands between actions. Start with the three earliest seats."
          ],
          "stats": {
            "types": [
              "RFI"
            ]
          },
          "practice": [
            {
              "kind": "own",
              "drill": {
                "id": "mtt-30-opens-early",
                "name": "Opening from early position",
                "description": "",
                "game": "mtt",
                "stack": 30,
                "exercises": [
                  {
                    "kind": "range",
                    "filter": {
                      "types": [
                        "RFI"
